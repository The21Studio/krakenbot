# Copia questo file in .env e inserisci le tue credenziali reali
# MAI committare il file .env su git

KRAKEN_API_KEY=inserisci_qui_la_tua_api_key
KRAKEN_SECRET=inserisci_qui_il_tuo_secret

TELEGRAM_BOT_TOKEN=inserisci_qui_il_token_del_bot
TELEGRAM_CHAT_ID=inserisci_qui_il_tuo_chat_id

# DRY_RUN=true  → simulazione, nessun ordine reale
# DRY_RUN=false → ordini reali su Kraken
DRY_RUN=true

# Mercati (true/false)
MARKET_CRYPTO=true
MARKET_FOREX=false
MARKET_STOCKS=false

# Forex (OANDA) e azioni (Alpaca), solo se abilitati
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
ALPACA_API_KEY=
ALPACA_SECRET=

# API della dashboard: cambiale SEMPRE prima di esporre il server
API_USERNAME=admin
API_PASSWORD=cambia_questa_password
JWT_SECRET=genera_una_stringa_casuale_lunga
